{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Environment: Plane (Headless)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/training/run_env.py",
            "args": [
                "--config",
                "${workspaceFolder}/training/configs/environment_plane.yaml",
                "--steps",
                "1000"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Train: Smoke",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/training/train.py",
            "args": [
                "--config",
                "${workspaceFolder}/training/configs/smoke.yaml"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Train: PPO Plane",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/training/train.py",
            "args": [
                "--config",
                "${workspaceFolder}/training/configs/ppo_plane.yaml"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
